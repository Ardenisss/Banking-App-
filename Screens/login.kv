<LoginScreen>:
    email_input: email_input
    password_input: password
    login_btn: login_btn
    forgot_btn: forgot_btn
    register_btn: register_btn

    AuthBackground:

    BoxLayout:
        size_hint: None, None
        width: dp(420)
        height: dp(360)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(14)

        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.18
            RoundedRectangle:
                pos: (self.x + dp(0), self.y - dp(6))
                size: (self.width, self.height + dp(6))
                radius: [12,]
            Color:
                rgba: 1, 1, 1, 0.98
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10,]

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(78)
            spacing: dp(6)

            Label:
                text: 'Email'
                size_hint_y: None
                height: dp(18)
                color: 0, 0, 0, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: email_input
                size_hint_y: None
                height: dp(48)
                multiline: False
                hint_text: 'you@example.com'

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(78)
            spacing: dp(6)

            Label:
                text: 'Password'
                size_hint_y: None
                height: dp(18)
                color: 0, 0, 0, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: password
                size_hint_y: None
                height: dp(48)
                multiline: False
                password: True

        BoxLayout:
            size_hint_y: None
            height: dp(92)
            spacing: dp(12)

            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 1
                spacing: dp(8)

                BoxLayout:
                    spacing: dp(12)

                    Button:
                        id: login_btn
                        text: 'Log in'
                        size_hint_y: None
                        height: dp(48)
                        canvas.before:
                            Rectangle:
                                pos: self.pos
                                size: self.size
                                source: 'Assets/GreenGradient.png'
                        color: 1,1,1,1
                        on_release: root.on_login_pressed()

                    Button:
                        id: register_btn
                        text: 'Register'
                        size_hint_y: None
                        height: dp(48)
                        canvas.before:
                            Rectangle:
                                pos: self.pos
                                size: self.size
                                source: 'Assets/GreenGradient.png'
                        color: 1,1,1,1
                        on_release: root.on_register_pressed()

                Label:
                    id: forgot_btn
                    text: 'Forgot password?'
                    size_hint_y: None
                    height: dp(24)
                    color: 0, 0.45, 0, 1
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
                    on_touch_down:
                        if self.collide_point(*args[1].pos): root.on_forgot_pressed()

    BoxLayout:
        id: error_box
        size_hint_y: None
        height: 0
        pos_hint: {'x': 0, 'top': 1}
        padding: dp(10)
        canvas.before:
            Color:
                rgba: 1, 0.2, 0.2, 0.95
            Rectangle:
                pos: self.pos
                size: self.size
        
        Label:
            id: error_message
            text: ''
            color: 1, 1, 1, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.size
