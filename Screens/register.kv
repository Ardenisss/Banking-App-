<RegisterScreen>:


    # optional Python properties (if you want to access these fields from Python)
    new_username_input: new_username
    new_password_input: new_password
    confirm_password_input: confirm_password
    submit_btn: submit_btn
    back_btn: back_btn

    Image:
        source: 'Login.png'
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
        allow_stretch: True
        keep_ratio: True

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(130)
        pos_hint: {'top': 1}

        Widget:
            size_hint_y: None
            height: dp(50)
            canvas:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

        Widget:
            size_hint_y: None
            height: dp(80)
            canvas:
                Rectangle:
                    pos: self.pos
                    size: self.size
                    source: 'GreenGradient.png'

    Widget:
        size_hint_y: None
        height: dp(200)
        pos_hint: {'y': 0}
        canvas:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'GreenGradient.png'

    # Register card (same dimensions & style as login card)
    BoxLayout:
        size_hint: None, None
        width: dp(420)
        height: dp(420)
        pos_hint: {'center_x': 0.5, 'center_y': 0.48}
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(12)

        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.18
            RoundedRectangle:
                pos: (self.x + dp(0), self.y - dp(6))
                size: (self.width, self.height + dp(6))
                radius: [12,]
            Color:
                rgba: 1, 1, 1, 0.98
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10,]

        Label:
            text: 'Create Account'
            font_size: dp(22)
            size_hint_y: None
            height: dp(34)
            color: 0, 0, 0, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        # Username
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(78)
            spacing: dp(6)

            Label:
                text: 'Username'
                size_hint_y: None
                height: dp(18)
                color: 0,0,0,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: new_username
                size_hint_y: None
                height: dp(48)
                multiline: False

        # Password
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(78)
            spacing: dp(6)

            Label:
                text: 'Password'
                size_hint_y: None
                height: dp(18)
                color: 0,0,0,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: new_password
                size_hint_y: None
                height: dp(48)
                multiline: False
                password: True

        # Confirm Password
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(78)
            spacing: dp(6)

            Label:
                text: 'Confirm password'
                size_hint_y: None
                height: dp(18)
                color: 0,0,0,1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: confirm_password
                size_hint_y: None
                height: dp(48)
                multiline: False
                password: True

        # Actions: Submit + Back
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(12)

            Button:
                id: submit_btn
                text: 'Create account'
                size_hint_x: 0.6
                canvas.before:
                    Rectangle:
                        pos: self.pos
                        size: self.size
                        source: 'GreenGradient.png'
                color: 1,1,1,1
                on_release:
                    # optionally call a Python handler (if you have one)
                    root.on_register_submit()
                    # app.root.current = 'login'  # default: go back to login

            Button:
                id: back_btn
                text: 'Back'
                size_hint_x: 0.4
                on_release: root.manager.current = 'login'

    FloatLayout:

        # bottom green gradient (behind the card)
        Widget:
            size_hint: 1, None
            height: dp(200)
            pos_hint: {'y': 0}
            canvas:
                Rectangle:
                    pos: self.pos
                    size: self.size
                    source: 'GreenGradient.png'

        # White card container (positioned towards the top; size_hint scales with screen)
        BoxLayout:
            id: dashboard_card
            orientation: 'vertical'
            size_hint: .92, .78
            pos_hint: {'center_x': .5, 'top': .86}   # stays near top as screen grows
            padding: dp(20)
            spacing: dp(12)

            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12,]
                Color:
                    rgba: 0, 0, 0, 0.06
                RoundedRectangle:
                    pos: (self.x, self.y - dp(6))
                    size: (self.width, self.height + dp(6))
                    radius: [12,]

            # Greeting (scales with width)
            Label:
                text: 'Good Morning!'
                color: 0, 0.45, 0, 1
                font_size: root.width * 0.05        # scales with screen width
                size_hint_y: None
                height: self.texture_size[1]
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                shorten: True

            # Row: subtitle (left) + balance (right) — swapped as requested
            BoxLayout:
                size_hint_y: None
                height: dp(24)
                spacing: dp(8)

                Label:
                    text: 'personal banking accounts'
                    font_size: dp(14)
                    color: .5, .5, .5, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    id: user_balance
                    text: '$5,432.10'            # placeholder (set from Python)
                    font_size: dp(14)
                    color: .5, .5, .5, 1
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size

            # Account cards (checking + savings) — stays toward top of card
            BoxLayout:
                size_hint_y: None
                height: dp(120)
                spacing: dp(12)

                # Checking card
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(12)
                    spacing: dp(6)
                    size_hint_x: 0.5

                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]
                        Color:
                            rgba: 0, 0, 0, 0.06
                        RoundedRectangle:
                            pos: (self.x, self.y - dp(4))
                            size: (self.width, self.height + dp(4))
                            radius: [10,]

                    BoxLayout:
                        size_hint_y: None
                        height: dp(28)
                        spacing: dp(8)

                        Label:
                            id: checking_balance
                            text: '$1,234.56'
                            font_size: dp(16)
                            color: 0, 0, 0, 1
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        Label:
                            text: 'Checking Account'
                            font_size: dp(16)
                            color: 0, 0, 0, 1
                            halign: 'right'
                            valign: 'middle'
                            text_size: self.size

                    Label:
                        text: 'Available balance'
                        font_size: dp(12)
                        color: .6, .6, .6, 1
                        size_hint_y: None
                        height: dp(18)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                # Savings card
                BoxLayout:
                    orientation: 'vertical'
                    padding: dp(12)
                    spacing: dp(6)
                    size_hint_x: 0.5

                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10,]
                        Color:
                            rgba: 0, 0, 0, 0.06
                        RoundedRectangle:
                            pos: (self.x, self.y - dp(4))
                            size: (self.width, self.height + dp(4))
                            radius: [10,]

                    BoxLayout:
                        size_hint_y: None
                        height: dp(28)
                        spacing: dp(8)

                        Label:
                            id: savings_balance
                            text: '$3,210.54'
                            font_size: dp(16)
                            color: 0, 0, 0, 1
                            halign: 'left'
                            valign: 'middle'
                            text_size: self.size

                        Label:
                            text: 'Savings Account'
                            font_size: dp(16)
                            color: 0, 0, 0, 1
                            halign: 'right'
                            valign: 'middle'
                            text_size: self.size

                    Label:
                        text: 'Available balance'
                        font_size: dp(12)
                        color: .6, .6, .6, 1
                        size_hint_y: None
                        height: dp(18)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

            # Action buttons row (icons + centered labels)
            BoxLayout:
                size_hint_y: None
                height: dp(110)
                spacing: dp(12)

                # Template button (repeat 3x)
                Button:
                    id: btn_statements
                    background_normal: ''
                    background_color: 1,1,1,1
                    on_release: print("statements")
                    BoxLayout:
                        orientation: 'vertical'
                        padding: dp(8)
                        spacing: dp(6)
                        AnchorLayout:
                            size_hint_y: None
                            height: dp(48)
                            anchor_x: 'center'
                            anchor_y: 'center'
                            canvas:
                                Color:
                                    rgba: .9, .9, .9, 1
                                Rectangle:
                                    pos: (self.x - dp(14), self.y - dp(14))
                                    size: (dp(36), dp(36))
                        Label:
                            text: 'Statements'
                            color: 0, 0.45, 0, 1
                            font_size: dp(14)
                            size_hint_y: None
                            height: dp(20)
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size

                Button:
                    id: btn_manage_cards
                    background_normal: ''
                    background_color: 1,1,1,1
                    on_release: print("manage cards")
                    BoxLayout:
                        orientation: 'vertical'
                        padding: dp(8)
                        spacing: dp(6)
                        AnchorLayout:
                            size_hint_y: None
                            height: dp(48)
                            anchor_x: 'center'
                            anchor_y: 'center'
                            canvas:
                                Color:
                                    rgba: .9, .9, .9, 1
                                Rectangle:
                                    pos: (self.x - dp(14), self.y - dp(14))
                                    size: (dp(36), dp(36))
                        Label:
                            text: 'Manage cards'
                            color: 0, 0.45, 0, 1
                            font_size: dp(14)
                            size_hint_y: None
                            height: dp(20)
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size

                Button:
                    id: btn_explore
                    background_normal: ''
                    background_color: 1,1,1,1
                    on_release: print("explore")
                    BoxLayout:
                        orientation: 'vertical'
                        padding: dp(8)
                        spacing: dp(6)
                        AnchorLayout:
                            size_hint_y: None
                            height: dp(48)
                            anchor_x: 'center'
                            anchor_y: 'center'
                            canvas:
                                Color:
                                    rgba: .9, .9, .9, 1
                                Rectangle:
                                    pos: (self.x - dp(14), self.y - dp(14))
                                    size: (dp(36), dp(36))
                        Label:
                            text: 'Explore products'
                            color: 0, 0.45, 0, 1
                            font_size: dp(14)
                            size_hint_y: None
                            height: dp(20)
                            halign: 'center'
                            valign: 'middle'
                            text_size: self.size

        # top gradient placed **after** card so it draws over the white card (overlap effect)
        Widget:
            size_hint_y: None
            height: dp(80)
            pos_hint: {'top': 1}
            canvas:
                Rectangle:
                    pos: self.pos
                    size: self.size
                    source: 'GreenGradient.png'