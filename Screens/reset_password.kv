<PasswordResetScreen>:
    reset_email_field: reset_email

    AuthBackground:

    BoxLayout:
        size_hint: None, None
        width: dp(420)
        height: dp(320)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(14)

        canvas.before:
            Color:
                rgba: 0, 0, 0, 0.18
            RoundedRectangle:
                pos: (self.x + dp(0), self.y - dp(6))
                size: (self.width, self.height + dp(6))
                radius: [12,]
            Color:
                rgba: 1, 1, 1, 0.98
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10,]

        Label:
            text: 'Reset Password'
            color: 0, 0.45, 0, 1
            font_size: dp(24)
            size_hint_y: None
            height: dp(40)
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            bold: True

        Label:
            text: 'Enter your email address and we\'ll send you a reset link'
            color: 0.5, 0.5, 0.5, 1
            font_size: dp(12)
            size_hint_y: None
            height: dp(40)
            halign: 'left'
            valign: 'top'
            text_size: self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(78)
            spacing: dp(6)

            Label:
                text: 'Email Address'
                size_hint_y: None
                height: dp(18)
                color: 0, 0, 0, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            TextInput:
                id: reset_email
                size_hint_y: None
                height: dp(48)
                multiline: False
                hint_text: 'you@example.com'

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(12)

            Button:
                text: 'Send Reset Link'
                size_hint_x: 0.7
                canvas.before:
                    Rectangle:
                        pos: self.pos
                        size: self.size
                        source: 'Assets/GreenGradient.png'
                color: 1, 1, 1, 1
                on_release: root.on_reset_submit()

            Button:
                text: 'Back'
                size_hint_x: 0.3
                background_color: 1, 1, 1, 1
                color: 1, 1, 1, 1
                on_release: root.on_back_pressed()

    BoxLayout:
        id: error_box
        size_hint_y: None
        height: 0
        pos_hint: {'x': 0, 'top': 1}
        padding: dp(10)
        canvas.before:
            Color:
                rgba: 1, 0.2, 0.2, 0.95
            Rectangle:
                pos: self.pos
                size: self.size
        
        Label:
            id: error_message
            text: ''
            color: 1, 1, 1, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.size
