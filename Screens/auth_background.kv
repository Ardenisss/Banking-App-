#:kivy 2.0
# Shared authentication background for login and register screens

<AuthBackground>:
    FloatLayout:
        Image:
            source: 'Assets/Login.png'
            size_hint: 1, 1.3
            pos_hint: {'x': 0, 'y': 0}
            allow_stretch: True
            keep_ratio: True

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(130)
            pos_hint: {'top': 1}

            Widget:
                size_hint_y: None
                height: dp(50)
                canvas:
                    Color:
                        rgba: 1, 1, 1, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            BoxLayout:
                size_hint_y: None
                height: dp(80)
                padding: dp(30), 0
                canvas.before:
                    Rectangle:
                        pos: self.pos
                        size: self.size
                        source: 'Assets/GreenGradient.png'
                
                Label:
                    text: 'ArdenBank'
                    font_size: dp(32)
                    color: 1, 1, 1, 1
                    bold: True
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.width, self.parent.height

        # Bottom green gradient with contact info
        BoxLayout:
            size_hint_y: None
            height: dp(200)
            pos_hint: {'y': 0}
            orientation: 'vertical'
            padding: dp(20)
            
            canvas.before:
                Rectangle:
                    pos: self.pos
                    size: self.size
                    source: 'Assets/GreenGradient.png'
            
            Widget:
                size_hint_y: 1
            
            BoxLayout:
                size_hint_y: None
                height: dp(80)
                orientation: 'vertical'
                spacing: 0
                
                Label:
                    text: 'Need to talk to us directly?'
                    color: 1, 1, 1, 1
                    font_size: dp(14)
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size
                    size_hint_y: None
                    height: dp(20)
                
                Button:
                    text: 'Contact Us!'
                    background_normal: ''
                    background_color: 0, 0.45, 0, 0
                    color: 0, 0.8, 0, 1
                    font_size: dp(14)
                    bold: True
                    size_hint_y: None
                    height: dp(30)
                    on_release: print("Contact Us clicked")
